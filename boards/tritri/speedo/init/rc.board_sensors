#!/bin/sh
#
# board specific sensors init
#------------------------------------------------------------------------------

board_adc start

# # # Internal SPI bus BMI088 accel/gyro
bmi088 -s -b 2 -A -R 0 start
bmi088 -s -b 2 -G -R 0 start

# # # Internal SPI bus BMI270 accel/gyro
bmi270 -s -b 3 -R 6 start

# # # Internal SPI bus ICM42688P accel/gyro
icm42688p -s -b 1 -R 0 start

# # # Internal mag
lis3mdl -I -b 2 -a 0x1C -R 6 start

# External compass on GPS I2C (IST8310 at 0x0C)
ist8310 -X -a 12 start

# # # External baro
bmp388 -X -b 2 -a 0x76 start
