#!/bin/sh
#
# @name SSRD Lampy Quadrotor SITL with Collision Prevention
#
# @type Quadrotor Wide
#
# @maintainer Custom Configuration
#

. ${R}etc/init.d/rc.mc_defaults

# Frame config from lampy_prod_backup.params
param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4

param set-default CA_ROTOR0_CT 6.50
param set-default CA_ROTOR0_KM 0.05
param set-default CA_ROTOR0_PX 0.061
param set-default CA_ROTOR0_PY 0.083
param set-default CA_ROTOR0_PZ 0

param set-default CA_ROTOR1_CT 6.50
param set-default CA_ROTOR1_KM 0.05
param set-default CA_ROTOR1_PX -0.06
param set-default CA_ROTOR1_PY -0.08
param set-default CA_ROTOR1_PZ 0

param set-default CA_ROTOR2_CT 6.50
param set-default CA_ROTOR2_KM -0.05
param set-default CA_ROTOR2_PX 0.06
param set-default CA_ROTOR2_PY -0.08
param set-default CA_ROTOR2_PZ 0

param set-default CA_ROTOR3_CT 6.50
param set-default CA_ROTOR3_KM -0.05


param set-default CA_ROTOR3_PX -0.06
param set-default CA_ROTOR3_PY 0.08
param set-default CA_ROTOR3_PZ 0

param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 104

# Battery (from lampy_prod_backup.params)
param set-default BAT1_N_CELLS 4
param set-default BAT1_V_CHARGED 4.2
param set-default BAT1_V_EMPTY 2.0
param set-default BAT1_A_PER_V 17
param set-default BAT_CRIT_THR 0.07
param set-default BAT_EMERGEN_THR 0.05
param set-default BAT_LOW_THR 0.15

# Collision Prevention Parameters
param set-default CP_DIST -1.0          # Enable collision prevention with 2m safety distance
param set-default CP_GO_NO_DATA 1      # Don't move without sensor data (safer)
param set-default MPC_POS_MODE 4       # Acceleration-based position mode (REQUIRED for collision prevention)
param set-default COM_OBS_AVOID 1     # Enable obstacle avoidance PROBABLY LEGACY BUT MAVLINK NEEDS IT
param set-default CP_DELAY 0.4         # Sensor delay compensation
param set-default CP_GUIDE_ANG 30      # Guidance angle for obstacle avoidance

# Keep PX4 on simulation time (HIL timestamps); don't sync to DDS agent system time (see docs/ROS2_CLOCK_AND_PX4_TIME.md)
param set-default UXRCE_DDS_SYNCT 0

# # ── GPS disabled; optical flow + range finder for navigation ─────────────────
# # No GPS hardware — allow arming and prevent GPS-dependent checks
# param set-default SYS_HAS_GPS 0
# param set-default MAV_USEHILGPS 0
# param set-default COM_ARM_WO_GPS 2
# param set-default EKF2_GPS_CTRL 0
# param set-default SIM_GPS_USED 0

