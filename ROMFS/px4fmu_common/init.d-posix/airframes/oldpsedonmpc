#!/bin/sh
#
# @name SSRD Speedo Quadrotor SITL (2 kg, APC 7x11E, 10k RPM hover)
#
# @type Quadrotor Wide
#
# @maintainer Custom Configuration
#
# Working copy in speedo_ws: config/px4/airframes/10018_ssrd_speedo
# Deploy into PX4 ROMFS (see config/px4/README.md).
#

. ${R}etc/init.d/rc.mc_defaults

# Frame config from speedo2.0bacupwip.params
param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4

param set-default CA_ROTOR0_CT 6.50
param set-default CA_ROTOR0_KM 0.05
param set-default CA_ROTOR0_PX 0.09
param set-default CA_ROTOR0_PY 0.09
param set-default CA_ROTOR0_PZ 0.03

param set-default CA_ROTOR1_CT 6.50
param set-default CA_ROTOR1_KM 0.05
param set-default CA_ROTOR1_PX -0.09
param set-default CA_ROTOR1_PY -0.09
param set-default CA_ROTOR1_PZ 0.03

param set-default CA_ROTOR2_CT 6.50
param set-default CA_ROTOR2_KM -0.05
param set-default CA_ROTOR2_PX 0.095
param set-default CA_ROTOR2_PY -0.09
param set-default CA_ROTOR2_PZ 0.03

param set-default CA_ROTOR3_CT 6.50
param set-default CA_ROTOR3_KM -0.05
param set-default CA_ROTOR3_PX -0.09
param set-default CA_ROTOR3_PY 0.09
param set-default CA_ROTOR3_PZ 0.03

param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 104

# Battery: 12S LiPo (44.4V nominal, 50.4V full)
param set-default BAT1_N_CELLS 12
param set-default BAT1_V_CHARGED 4.2
param set-default BAT1_V_EMPTY 3.2
# BAT1_A_PER_V not in this PX4 version
param set-default BAT_CRIT_THR 0.20
param set-default BAT_EMERGEN_THR 0.05
param set-default BAT_LOW_THR 0.35

# MC attitude gains (from speedo2.0bacupwip.params)
param set-default MC_ROLL_P 8.0
param set-default MC_PITCH_P 8.0
# Yaw: softer P + rate PID + torque LPF reduces SITL / high-gain XY oscillation on heading.
param set-default MC_YAW_P 2.1
param set-default MC_ROLLRATE_P 0.15
param set-default MC_ROLLRATE_I 0.3
param set-default MC_ROLLRATE_D 0.0022
param set-default MC_ROLLRATE_K 1.35
param set-default MC_PITCHRATE_P 0.15
param set-default MC_PITCHRATE_I 0.3
param set-default MC_PITCHRATE_D 0.0022
param set-default MC_PITCHRATE_K 1.35 #NOTE INCREAED FOR SIM TO MAKE NMPC WORK
param set-default MC_YAWRATE_P 0.12
param set-default MC_YAWRATE_I 0.04
param set-default MC_YAWRATE_D 0.002
param set-default MC_YAWRATE_FF 0.0
param set-default MC_YAWRATE_K 0.35
param set-default MC_YR_INT_LIM 0.15
param set-default MC_YAW_TQ_CUTOFF 1.2
param set-default MC_YAW_WEIGHT 0.4

# MPC position / velocity PID (tuned a bit hotter for SITL trajectory tracking)
param set-default MPC_XY_P 1.2
param set-default MPC_Z_P 1.25
param set-default MPC_XY_VEL_P_ACC 2.3
param set-default MPC_XY_VEL_I_ACC 0.5
param set-default MPC_XY_VEL_D_ACC 0.28
param set-default MPC_Z_VEL_P_ACC 9.5
param set-default MPC_Z_VEL_I_ACC 2.5
param set-default MPC_Z_VEL_D_ACC 0.12
param set-default MPC_THR_HOVER 0.21
param set-default MPC_XY_CRUISE 5.0
param set-default MPC_XY_VEL_MAX 100.0 # NOTE INCREASED FOR SIM HIGH SPEED TRACKING (before 12.0)
param set-default MPC_Z_VEL_MAX_UP 100.0 # NOTE INCREASED FOR SIM HIGH SPEED TRACKING (before 3.0)
# Was 1.5 — below VehicleConstraints speed_down (~3 m/s) in autonomus_flightmodes; raise so PX4 does not clamp descent.
param set-default MPC_Z_VEL_MAX_DN 5.0
param set-default MPC_ACC_HOR 10.0 # Horizontal acceleration for autonomous modes
param set-default MPC_ACC_HOR_MAX 12.0 # Max horizontal acceleration
param set-default MPC_ACC_UP_MAX 8.0 # Max upward acceleration
param set-default MPC_ACC_DOWN_MAX 6.0 # Max downward acceleration
param set-default MPC_JERK_AUTO 20.0 # Jerk limit for autonomous modes
param set-default MPC_JERK_MAX 30.0 # Max jerk for manual position mode
# Smoother auto yaw rate / accel (less hunting when trajectory yaw is unconstrained).
param set-default MPC_YAWRAUTO_MAX 45.0
param set-default MPC_YAWRAUTO_ACC 12.0
# Max tilt in position modes [deg]. PX4 metadata caps MPC_TILTMAX_AIR at 89 (closest to “90”).
param set-default MPC_TILTMAX_AIR 89
# Takeoff climb profile (see PX4 src/modules/mc_pos_control/multicopter_takeoff_land_params.c)
# MPC_TKO_RAMP_T: smooth takeoff ramp time constant [s] — default 3 is slow; 0 disables the ramp.
# MPC_TKO_SPEED: takeoff climb rate [m/s] — default 1.5; raise with MPC_Z_VEL_MAX_UP / acc limits.
param set-default MPC_TKO_RAMP_T 0.5
param set-default MPC_TKO_SPEED 5.0
# SITL: shorter post-arm idle window (increase for real hardware / prop checks).
param set-default COM_SPOOLUP_TIME 0.5
# Keep PX4 on simulation time (HIL timestamps)
param set-default UXRCE_DDS_SYNCT 0

# Offboard/swarm: no RC required
param set COM_RC_IN_MODE 1
param set NAV_RCL_ACT 0
param set COM_RCL_EXCEPT 4
param set COM_RC_OVERRIDE 0
