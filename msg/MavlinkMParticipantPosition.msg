# Friendly-participant position/identity (PPLI-style / Blue Force Tracking)
#
# MAVLink-M message PARTICIPANT_POSITION (id 53003).
# Published by: mavlink_receiver for *peer* PPLI (origin_sysid != local).
# Own-ship PPLI is generated by the PARTICIPANT_POSITION MAVLink stream from the estimator.
#
uint64 timestamp # [us] Time since system start

uint64 time_usec # [us] Timestamp (UNIX epoch, microseconds UTC).
int32 lat # [degE7] Participant latitude, WGS84.
int32 lon # [degE7] Participant longitude, WGS84.
float32 alt # [m] Participant altitude, MSL. NaN if unknown.
float32 vx # [m/s] Velocity north (NED). NaN if unknown.
float32 vy # [m/s] Velocity east (NED). NaN if unknown.
float32 vz # [m/s] Velocity down (NED). NaN if unknown.
float32 course # [deg] Course over ground. NaN if unknown.
char[20] external_track_number # External/joint track number or URN for this participant. Empty if none.
char[50] callsign # Human-readable callsign/designation (null-terminated).
uint8 origin_sysid # System ID of the reporting participant.
uint8 external_track_type # Namespace of external_track_number.
uint8 stanag_identity # Standard identity (normally FRIEND for own-force PPLI).
uint8 ppli_type # Participant environment/type.
