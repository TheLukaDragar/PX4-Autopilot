# Lean C-UAS live air kinematics (MAVLink TRITRI_TARGET id 53901).
# Peer RX and companion TX must not share one uORB topic or the stream
# rebroadcasts C2/peer samples under this vehicle's header.
#   mavlink_m_tritri_target      — RX → /fmu/out (network heard)
#   mavlink_m_tritri_target_send — /fmu/in → TRITRI_TARGET stream (own-origin)
#
# TOPICS mavlink_m_tritri_target mavlink_m_tritri_target_send

uint64 timestamp # [us] Time since system start

uint64 time_usec # [us] Timestamp (UNIX epoch, microseconds UTC).
uint64 target_time_usec # [us] Timestamp when the target fix was valid (UNIX epoch, microseconds UTC).
uint8[16] track_uid # Track UID correlating to TRITRI_TRACK. All-zero if unknown.
char[16] target_name # Short human-readable callsign (null-terminated).
uint32 target_id # Unique target identifier generated by the source system.
uint32 target_set_id # Parent target set identifier. 0 = none.
uint32 flags # Target warning and status flags.
int32 lat # [degE7] Target latitude, WGS84. INT32_MAX if unknown.
int32 lon # [degE7] Target longitude, WGS84. INT32_MAX if unknown.
float32 alt # [m] Target altitude, MSL. NaN if unknown.
float32 vx # [m/s] Velocity north (NED). NaN if unknown.
float32 vy # [m/s] Velocity east (NED). NaN if unknown.
float32 vz # [m/s] Velocity down (NED). NaN if unknown.
float32 cov_pos_x # Position covariance, north axis (m^2). NaN if unknown.
float32 cov_pos_y # Position covariance, east axis (m^2). NaN if unknown.
float32 cov_pos_z # Position covariance, down axis (m^2). NaN if unknown.
float32 cov_vel_x # Velocity covariance, north axis (m^2/s^2). NaN if unknown.
float32 cov_vel_y # Velocity covariance, east axis (m^2/s^2). NaN if unknown.
float32 cov_vel_z # Velocity covariance, down axis (m^2/s^2). NaN if unknown.
uint16 confidence # Classification or detection confidence scaled 0-10000.
uint8 target_class # Target classification.
uint8 target_domain # Primary operating domain.
uint8 target_force # Force affiliation.
uint8 sensor_type # Primary sensor source.
uint8 tle_category # Target-location-error category label. 0 if unset.
uint8 restricted_target_flags # No-strike / restricted / NFA flags. 0 if none.
