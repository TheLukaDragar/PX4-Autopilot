# Position, velocity, classification, engagement context, and optional external package location fo...
#
# MAVLink-M message TARGET (id 53010).
# Published by: mavlink_receiver (when dialect includes military.xml).
#
uint64 timestamp # [us] Time since system start

uint64 time_usec # [us] Timestamp (UNIX epoch, microseconds UTC).
uint64 target_time_usec # [us] Timestamp when the target was detected or designated (UNIX epoch, microseconds UTC).
uint32 target_id # Unique target identifier generated by the source system.
uint32 target_set_id # Parent target set identifier.
uint32 package_id_hash # Compact hash or identifier for the associated target package. 0 if no package is associated.
char[50] target_name # Human-readable target name (null-terminated).
int32 lat # [degE7] Target latitude, WGS84.
int32 lon # [degE7] Target longitude, WGS84.
float32 alt # [m] Target altitude, MSL.
float32 vx # [m/s] Velocity north component (NED).
float32 vy # [m/s] Velocity east component (NED).
float32 vz # [m/s] Velocity down component (NED).
float32 cov_pos_x # Position covariance, north axis (m^2).
float32 cov_pos_y # Position covariance, east axis (m^2).
float32 cov_pos_z # Position covariance, down axis (m^2).
float32 cov_vel_x # Velocity covariance, north axis (m^2/s^2).
float32 cov_vel_y # Velocity covariance, east axis (m^2/s^2).
float32 cov_vel_z # Velocity covariance, down axis (m^2/s^2).
float32 cep_desired # [m] Desired circular error probable.
float32 cep_max # [m] Maximum acceptable circular error probable.
uint32 flags # Target warning and status flags.
uint32 package_endpoint_ip_1 # Primary IPv4 endpoint address for target package retrieval, packed as (a&lt;&lt;24)|(b&lt;&lt;16)|(c&lt;&lt;8)|d for address a.b.c.d; for example, 192.168.1.10 is 0xC0A8010A. 0 if unused.
uint32 package_endpoint_ip_2 # Secondary IPv4 endpoint address for target package retrieval, packed as (a&lt;&lt;24)|(b&lt;&lt;16)|(c&lt;&lt;8)|d for address a.b.c.d. 0 if unused.
uint32 package_endpoint_ip_3 # Third IPv4 endpoint address for target package retrieval, packed as (a&lt;&lt;24)|(b&lt;&lt;16)|(c&lt;&lt;8)|d for address a.b.c.d. 0 if unused.
uint8 target_class # Target classification.
uint8 target_domain # Primary operating domain of the target.
uint8 target_entity_2525d # Optional MIL-STD-2525D land target entity refinement. UNKNOWN if not provided or not a land entity.
uint8 target_force # Force affiliation.
uint16 confidence # Classification or detection confidence scaled from 0 to 10000, where 0 = 0.0 and 10000 = 1.0.
uint16 package_endpoint_port # TCP port for target package retrieval. 0 if no package is associated.
uint8 sensor_type # Primary sensor source used for target identification.
uint8 package_transport # Transport protocol used to retrieve the target package.
char[80] package_path # Path component for target package retrieval, null-terminated. Empty if no package is associated.
uint16 prf_code # Laser designator PRF code for SAL engagement (e.g. 1111-1788). 0 = no laser code assigned.
uint8 tle_category # Target-location-error category (label only, not a mensuration figure).
uint8 dmpi_reference_kind # How the DMPI reference is expressed. A mensurated DMPI tied to a weapon solution is NOT carried.
uint8 restricted_target_flags # No-strike / restricted-target / no-fire-area context flags (bitmask).
